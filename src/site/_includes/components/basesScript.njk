<script>
document.addEventListener("DOMContentLoaded", function() {
  document.querySelectorAll(".obsidian-bases-views").forEach(function(container) {
    var toggle = container.querySelector(".obsidian-bases-active-view");
    var dropdown = container.querySelector(".obsidian-bases-dropdown");
    var items = container.querySelectorAll(".obsidian-bases-dropdown-item");
    var panels = container.querySelectorAll(".obsidian-bases-view-panel");
    var nameEl = container.querySelector(".obsidian-bases-active-view-name");
    var countEl = container.querySelector(".obsidian-bases-count-value");

    if (!toggle || !dropdown) return;

    // Toggle dropdown on click
    toggle.addEventListener("click", function(e) {
      e.stopPropagation();
      var open = dropdown.style.display !== "none";
      dropdown.style.display = open ? "none" : "block";
      toggle.setAttribute("aria-expanded", !open);
    });

    // Close dropdown on outside click
    document.addEventListener("click", function() {
      dropdown.style.display = "none";
      toggle.setAttribute("aria-expanded", "false");
    });

    // Switch view on item click
    items.forEach(function(item) {
      item.addEventListener("click", function(e) {
        e.stopPropagation();
        var idx = this.getAttribute("data-view-index");

        // Update active states
        items.forEach(function(el) { el.classList.remove("active"); });
        this.classList.add("active");

        // Switch panels
        panels.forEach(function(p) { p.style.display = "none"; });
        var target = container.querySelector('.obsidian-bases-view-panel[data-view-index="' + idx + '"]');
        if (target) target.style.display = "block";

        // Update toolbar button text and icon
        var icon = this.querySelector(".obsidian-bases-view-icon");
        var activeIcon = toggle.querySelector(".obsidian-bases-view-icon");
        if (icon && activeIcon) activeIcon.replaceWith(icon.cloneNode(true));
        if (nameEl) nameEl.textContent = this.textContent.trim();

        // Update result count
        if (countEl && target) {
          var rows = target.querySelectorAll("tbody tr:not(.obsidian-base-group-row), .obsidian-base-card, .obsidian-base-list li");
          countEl.textContent = rows.length;
        }

        // Close dropdown
        dropdown.style.display = "none";
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  });

  // Format date cells. The timestamps plugin formats .human-date spans with
  // the garden's configured format when it's enabled; any left empty here
  // get a locale format so date columns never render blank.
  document.querySelectorAll(".obsidian-bases-views .human-date").forEach(function(el) {
    if (el.textContent.trim() !== "") return;
    var value = (el.getAttribute("data-date") || "").trim();
    var dateOnly = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    // Date-only values are calendar days, not instants: build them in
    // local time so the viewer's timezone can't shift the day
    var date = dateOnly
      ? new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
      : new Date(value);
    if (isNaN(date.getTime())) {
      el.textContent = value;
      return;
    }
    var options = { year: "numeric", month: "short", day: "numeric" };
    if (!dateOnly) {
      options.hour = "numeric";
      options.minute = "2-digit";
    }
    el.textContent = date.toLocaleString(undefined, options);
  });

  // Fill in dynamic date placeholders (today/now)
  document.querySelectorAll(".bases-dynamic-date").forEach(function(el) {
    var type = el.getAttribute("data-type");
    var now = new Date();
    if (type === "today") {
      var y = now.getFullYear();
      var m = String(now.getMonth() + 1).padStart(2, "0");
      var d = String(now.getDate()).padStart(2, "0");
      el.textContent = y + "-" + m + "-" + d;
    } else if (type === "now") {
      var y = now.getFullYear();
      var m = String(now.getMonth() + 1).padStart(2, "0");
      var d = String(now.getDate()).padStart(2, "0");
      var h = String(now.getHours()).padStart(2, "0");
      var min = String(now.getMinutes()).padStart(2, "0");
      el.textContent = y + "-" + m + "-" + d + " " + h + ":" + min;
    }
  });
});
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    window.addEventListener('load', function() {
      // Находим все схемы Excalidraw
      const images = document.querySelectorAll('img[src*=".svg"], .excalidraw-svg');

      images.forEach(img => {
        img.style.cursor = 'zoom-in';
        img.style.transition = 'transform 0.1s ease-out';
        img.style.transformOrigin = 'center center';
        
        // Создаем изолированный контейнер-рамку
        const viewContainer = document.createElement('div');
        viewContainer.style.cssText = 'width: 100%; max-width: 800px; height: 500px; border: 1px solid var(--border-color, #ccc); border-radius: 8px; overflow: hidden; margin: 20px auto; background: var(--background-secondary, #fafafa); display: flex; align-items: center; justify-content: center; position: relative; user-select: none;';
        
        // Создаем кнопку сброса в углу рамки
        const resetBtn = document.createElement('button');
        resetBtn.innerHTML = '🎯 Сбросить зум';
        resetBtn.style.cssText = 'position: absolute; top: 15px; right: 15px; z-index: 100; padding: 6px 12px; font-size: 13px; background: rgba(0, 0, 0, 0.75); color: #fff; border: none; border-radius: 20px; cursor: pointer; display: none; font-family: sans-serif; transition: opacity 0.2s, background 0.2s;';
        resetBtn.onmouseover = () => resetBtn.style.background = 'rgba(0, 0, 0, 0.9)';
        resetBtn.onmouseout = () => resetBtn.style.background = 'rgba(0, 0, 0, 0.75)';

        img.parentNode.insertBefore(viewContainer, img);
        viewContainer.appendChild(img);
        viewContainer.appendChild(resetBtn);

        // Переменные состояния
        let scale = 1;
        let isDragging = false;
        let startX, startY;
        let translateX = 0, translateY = 0;
        let hasMoved = false; // Флаг, отличающий клик от перемещения

        function applyTransform(animate = true) {
          img.style.transition = animate ? 'transform 0.15s ease-out' : 'none';
          img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
          
          // Показываем кнопку сброса только при зуме
          if (scale > 1) {
            resetBtn.style.display = 'block';
          } else {
            resetBtn.style.display = 'none';
          }
        }

        // 1. УПРАВЛЕНИЕ МАСШТАБОМ (КОЛЕСИКО МЫШИ)
        viewContainer.addEventListener('wheel', function (e) {
          e.preventDefault(); // Блокируем скролл всей страницы сайта

          const zoomFactor = 0.25;
          if (e.deltaY < 0) {
            if (scale < 6) scale += zoomFactor;
          } else {
            if (scale > 1) scale -= zoomFactor;
          }

          if (scale === 1) {
            translateX = 0;
            translateY = 0;
            img.style.cursor = 'zoom-in';
          } else {
            img.style.cursor = 'move';
          }

          applyTransform(true);
        });

        // 2. НАЧАЛО ПЕРЕТАСКИВАНИЯ
        viewContainer.addEventListener('mousedown', function (e) {
          if (scale <= 1) return;
          isDragging = true;
          hasMoved = false; // Обнуляем флаг движения при каждом нажатии
          img.style.transition = 'none';
          startX = e.clientX - translateX;
          startY = e.clientY - translateY;
        });

        // 3. ПРОЦЕСС ПЕРЕТАСКИВАНИЯ
        viewContainer.addEventListener('mousemove', function (e) {
          if (!isDragging) return;
          hasMoved = true; // Мышка сдвинулась — значит это перетаскивание, а не простой клик!
          translateX = e.clientX - startX;
          translateY = e.clientY - startY;
          applyTransform(false);
        });

        // 4. КОНЕЦ ПЕРЕТАСКИВАНИЯ
        window.addEventListener('mouseup', function () {
          isDragging = false;
        });

        // 5. КЛИК ПО КАРТИНКЕ (Плавный зум-эффект при обычном клике без перемещения)
        img.addEventListener('click', function (e) {
          // Если мы тащили картинку, игнорируем клик и не сбрасываем масштаб
          if (hasMoved) return; 

          // Если картинка в обычном состоянии, клик увеличивает её сразу до 2x
          if (scale === 1) {
            scale = 2;
            img.style.cursor = 'move';
            applyTransform(true);
          }
        });

        // 6. ЛОГИКА РАБОТЫ КНОПКИ СБРОСА
        resetBtn.addEventListener('click', function (e) {
          e.stopPropagation(); // Отменяем всплытие события, чтобы не триггерить клик по картинке
          scale = 1;
          translateX = 0;
          translateY = 0;
          img.style.cursor = 'zoom-in';
          applyTransform(true);
        });
      });
    });
  });
</script>
